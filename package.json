{
  "name": "gh-pulse",
  "version": "0.3.1",
  "description": "An interactive terminal dashboard for everything on GitHub that's waiting on you",
  "keywords": [
    "github",
    "gh-extension",
    "cli",
    "tui",
    "terminal",
    "dashboard",
    "pull-requests",
    "code-review",
    "notifications",
    "ai",
    "claude",
    "ink"
  ],
  "homepage": "https://github.com/tadiPro250/gh-pulse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tadiPro250/gh-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/tadiPro250/gh-pulse/issues"
  },
  "type": "module",
  "bin": {
    "pulse": "bin/pulse.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/cli.js --bundle --platform=node --format=esm --target=node22 --packages=external --jsx=automatic --outfile=dist/cli.js",
    "dev": "npm run build -- --watch",
    "prepare": "npm run build",
    "test:build": "esbuild test/tui-smoke.jsx test/handoff.jsx test/setup.jsx --bundle --platform=node --format=esm --packages=external --jsx=automatic --outdir=test/.out --log-level=warning",
    "test": "npm run test:build && node test/actions.test.js && node --env-file=test/.env test/.out/tui-smoke.js && node --env-file=test/.env test/.out/handoff.js && node --env-file=test/.env test/.out/setup.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "ink": "^8.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0"
  }
}
